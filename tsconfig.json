{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "index.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "contracts/**/*.ts",
    "patterns/**/*.ts",
    "icons/**/*.ts",
    "icons/**/*.tsx",
    "global.d.ts",
    ".storybook/**/*.ts",
    "stories/**/*.ts",
    "stories/**/*.tsx"
  ]
}
